{
  "name": "@chatbase/admin",
  "version": "0.1.0",
  "private": true,
  "description": "The platform-operator dashboard, run separately from the customer app.",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port ${ADMIN_PORT:-3001}",
    "typecheck": "tsc --noEmit",
    "smoke": "node --env-file-if-exists=../../.env scripts/smoke-admin.mjs",
    "smoke:insights": "node --env-file-if-exists=../../.env scripts/smoke-insights.mjs"
  },
  "dependencies": {
    "@chatbase/core": "workspace:*",
    "@chatbase/ui": "workspace:*",
    "jose": "^6.2.12",
    "next": "^15.5.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
