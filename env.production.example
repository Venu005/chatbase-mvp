# =====================================================================================================
#  Chatbase India: PRODUCTION environment file
#
#    cp .env.production.example .env        (on the server, in the app folder)
#    fill in every REPLACE_ME, then:   pnpm preflight --live
#
#  Everything below is the recommended production shape. Optional features are marked; leave a value blank
#  (KEY=) to switch that feature off. Explanations of each variable: .env.example and docs/setup.md
#  Never commit the filled-in file.
# =====================================================================================================

# ---------- Core (required) ----------
# A managed Postgres 15+ with the pgvector extension (or your own). Use a strong password and SSL if remote:
#   postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=REPLACE_ME
# openssl rand -base64 48
AUTH_SECRET=REPLACE_ME
# openssl rand -base64 48   (different from AUTH_SECRET; back it up, losing it means customers reconnect WhatsApp)
ENCRYPTION_KEY=REPLACE_ME
# Your public https address, no trailing slash
APP_URL=https://REPLACE_ME.example.in

# ---------- AI models (required) ----------
# Pick ONE chat provider: openai | anthropic | sarvam    (see docs/providers.md for tested recipes)
LLM_PROVIDER=REPLACE_ME
LLM_MODEL=REPLACE_ME
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
SARVAM_API_KEY=
SARVAM_BASE_URL=
SARVAM_REASONING_EFFORT=none
SARVAM_MAX_TOKENS=1024

# Embeddings must be a real model in production (Sarvam and Anthropic have none: use OpenAI or a compatible server)
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=REPLACE_ME
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
# Must match the model, and must be set BEFORE the first `pnpm migrate`
EMBEDDING_DIM=1536
EMBEDDING_SEND_DIMENSIONS=false
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.25

# ---------- WhatsApp: Embedded Signup (optional; all four or none) ----------
META_APP_ID=
META_APP_SECRET=
META_ES_CONFIG_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=

# ---------- Razorpay (optional) ----------
# Start with rzp_test_ keys. Switch to rzp_live_ only after a full test-mode run and Razorpay's account activation.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_GROWTH=
RAZORPAY_PLAN_PRO=

# ---------- E-mail alerts (optional, recommended) ----------
SMTP_URL=
EMAIL_FROM=
HANDOFF_EMAIL_COOLDOWN_MINUTES=
HANDOFF_AUTO_RESUME_HOURS=

# ---------- Safety: leave as is ----------
ALLOW_PRIVATE_URLS=false
SIGNUP_RATE_LIMIT=
