# =====================================================================================================
#  Chatbase India: environment file (development defaults)
#
#    cp .env.example .env        then fill in the values marked REPLACE_ME
#    pnpm preflight              checks the file and your database
#    pnpm preflight --live       also tests your API keys for real (uses a few tokens)
#
#  Rules of thumb
#   - An EMPTY value (KEY=) is the same as not setting it. Leave features you don't use blank.
#   - No quotes, no spaces around "=", no trailing comments on a value line.
#   - Avoid a literal $ in values (Next.js expands it). In a password write it URL-encoded as %24.
#   - Never commit your real .env. For a server, start from .env.production.example.
#   - Full reference of every variable: docs/setup.md
# =====================================================================================================


# ==================== 1. CORE (required) ====================
# Postgres with the pgvector extension. `docker compose up -d` starts one that matches this URL.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chatbase_india

# Signs login cookies. Random, 32+ characters:   openssl rand -base64 48
AUTH_SECRET=REPLACE_ME_with_output_of_openssl_rand_base64_48

# The address people use to reach the app. Used for embed snippets, e-mail links, WhatsApp callback URLs
# and secure cookies (https:// turns them on). For WhatsApp/Razorpay webhooks it must be PUBLIC https
# (use an ngrok or Cloudflare Tunnel address while developing).
APP_URL=http://localhost:3000

# Encrypts customers' WhatsApp tokens in the database. Random, 32+ characters. If blank it is derived from
# AUTH_SECRET (works, but then rotating AUTH_SECRET would make stored tokens unreadable). Set it in production
# and back it up: losing it means every customer has to reconnect WhatsApp.
ENCRYPTION_KEY=


# ==================== 2. AI MODELS (required for real answers) ====================
# --- Chat model: mock | openai | anthropic | sarvam ---
#   mock       offline test model that just quotes your documents (default; no key needed)
#   openai     OpenAI or ANY OpenAI-compatible server (Azure/Bedrock gateways, vLLM, Ollama, LiteLLM...)
#   anthropic  Claude
#   sarvam     Sarvam AI (Indian-language models)
LLM_PROVIDER=mock

# Model id your account can use. Required for openai and anthropic; optional for sarvam (default sarvam-105b).
# Examples: gpt-4o-mini | a Claude model id from your Anthropic console | sarvam-105b
LLM_MODEL=

# openai / openai-compatible (leave OPENAI_BASE_URL blank for api.openai.com)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# anthropic (leave the base URL blank unless you use a gateway)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# sarvam: key from https://dashboard.sarvam.ai
SARVAM_API_KEY=
SARVAM_BASE_URL=
# none | low | medium | high. "none" turns reasoning off: faster and cheaper, best for support answers.
SARVAM_REASONING_EFFORT=none
SARVAM_MAX_TOKENS=1024
# WhatsApp voice notes are transcribed with Sarvam speech-to-text whenever SARVAM_API_KEY is set (whatever
# LLM_PROVIDER is). VOICE_NOTES=off turns that off. Model: saaras:v3 (default); clips must be under 30 seconds.
VOICE_NOTES=
SARVAM_STT_MODEL=

# --- Embeddings (how documents are searched): mock | openai ---
#   mock    offline keyword hashing, NOT semantic (development only)
#   openai  OpenAI or any OpenAI-compatible /embeddings endpoint. Sarvam and Anthropic have no embeddings API,
#           so pair them with this.
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
# Blank = OPENAI_API_KEY / OPENAI_BASE_URL are reused
EMBEDDING_BASE_URL=
# Blank = text-embedding-3-small
EMBEDDING_MODEL=
# Vector size of the model. SET BEFORE `pnpm migrate`: it is baked into the database. text-embedding-3-small = 1536.
# Changing it later needs an empty database (or re-migrating and re-indexing everything).
EMBEDDING_DIM=1536
# true only for models that accept a `dimensions` parameter (lets you shrink e.g. text-embedding-3-large to 1536)
EMBEDDING_SEND_DIMENSIONS=false

# --- Reliability of AI calls (blank = default) ---
# Time limits: waiting for the first word (default 20000 ms) and for the whole answer (default 90000 ms).
LLM_FIRST_TOKEN_TIMEOUT_MS=
LLM_TIMEOUT_MS=
# Retries for rate limits / overload / server errors before any text is shown (default 2), with backoff.
LLM_RETRIES=
# Optional backup model used when the main one keeps failing, e.g. LLM_FALLBACK_PROVIDER=openai + a small model.
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
# Optional cheaper model for small talk ("hi", "thanks") and questions a Q&A answer matches closely (score >= ROUTE_FIX_SCORE,
# default 0.8), e.g. LLM_SMALL_PROVIDER=openai with a mini model. Off when blank.
LLM_SMALL_PROVIDER=
LLM_SMALL_MODEL=
ROUTE_FIX_SCORE=
# Longest answer, in tokens (anthropic default 1024; openai-compatible: provider default when blank).
LLM_MAX_TOKENS=
# Conversation history sent with each question, in characters (default 6000, about 1,500 tokens).
HISTORY_MAX_CHARS=
# Embedding calls: time limit (default 30000 ms) and retries (default 3).
EMBEDDING_TIMEOUT_MS=
EMBEDDING_RETRIES=

# --- Ingestion queue (blank = default) ---
# Jobs run at once per server (default 2), attempts for transient failures (default 3), first retry delay (default 30000 ms,
# doubling each time). INGEST_WORKER=off stops this server from running ingestion jobs.
INGEST_CONCURRENCY=
INGEST_MAX_ATTEMPTS=
INGEST_RETRY_BASE_MS=
INGEST_WORKER=

# --- Admin app (apps/admin, http://localhost:3001) ---
# E-mails of the first admins, comma-separated. They sign in with ADMIN_PASSWORD (12+ characters:
# openssl rand -base64 24) and can add more admins in the app's Admins tab. See docs/admin.md.
ADMIN_EMAILS=
ADMIN_PASSWORD=
# Public address of the admin app (https:// turns on secure admin cookies). Blank is fine locally.
ADMIN_URL=

# --- Cost tracking (admin view) ---
# USD per million input/output tokens, per model id: "gpt-4.1-mini=0.40/1.60, claude-haiku-4-5=1/5". Check your provider's
# current price list. Models without a price show tokens but no cost.
LLM_PRICES=
# USD per million tokens for the embedding model.
EMBEDDING_PRICE_PER_MTOK=
# Optional: show costs in rupees as well (e.g. 88.5).
USD_INR_RATE=

# --- Reading hard sources (optional) ---
# OCR: scanned PDFs (no text layer) and photos (JPG/PNG/WEBP) of price lists or menus are read by a vision model.
# OCR_PROVIDER=openai (any OpenAI-compatible API accepting images and PDF files) or anthropic, plus a vision model id.
# OCR_API_KEY / OCR_BASE_URL default to that provider's OPENAI_* / ANTHROPIC_* settings.
OCR_PROVIDER=
OCR_MODEL=
OCR_API_KEY=
OCR_BASE_URL=
# Websites that build their pages with JavaScript: a rendering service URL with {url}, returning the rendered HTML
# (e.g. a self-hosted Browserless /content endpoint or any prerender service).
PRERENDER_URL=

# --- Answer cache ---
# A visitor's first question asked word for word before (ignoring case and punctuation) gets the stored answer, as long
# as nothing that shapes answers changed (sources, Q&A answers, instructions, prompt, model). "off" disables it.
ANSWER_CACHE=
# How long a cached answer is reused (default 24 hours).
ANSWER_CACHE_TTL_HOURS=

# --- Retrieval tuning ---
RETRIEVAL_TOP_K=6
# Passages scoring below this cosine similarity are ignored. 0.1 suits the mock embeddings. With a real
# embedding model start around 0.25 and tune on your own customers' questions.
RETRIEVAL_MIN_SCORE=0.1
# Passage size in characters (default 900) and overlap (default 120). Smaller passages give more precise matches for
# dense lists (price lists) but can pull loosely related text into unrelated questions: measure with pnpm eval.
CHUNK_SIZE=
CHUNK_OVERLAP=
# Keyword search next to meaning search (product codes, names, Hindi/Hinglish words); "off" = meaning search only.
HYBRID_SEARCH=
# A passage found only by keywords must contain at least this share of the question's words (default 0.5).
KEYWORD_MIN_COVERAGE=
# Optional reranking of search results with a Cohere- or Jina-compatible /rerank API (off unless both are set).
# Jina: RERANK_BASE_URL=https://api.jina.ai/v1  RERANK_MODEL=jina-reranker-v2-base-multilingual
RERANK_API_KEY=
RERANK_MODEL=
RERANK_BASE_URL=
# Optional: rewrite follow-up questions ("and the 10 kg one?") into standalone search queries with a small model.
# on | off (default off). Adds one short model call per follow-up; enable it if pnpm eval shows a gain with your models.
QUERY_REWRITE=
QUERY_REWRITE_PROVIDER=
QUERY_REWRITE_MODEL=
# How close a visitor's question must be to one of your Q&A answers (Q&A tab / "Fix this answer") for that
# answer to be used. Higher = only near-identical questions. 0.5 works for the mock and for OpenAI embeddings.
ANSWER_FIX_MIN_SCORE=0.5


# ==================== 3. WHATSAPP (optional) ====================
# Two ways to connect a number; you can offer both:
#  A) Manual: the customer pastes their own Phone number ID, token and app secret in the dashboard.
#     Needs NOTHING below, only a public https APP_URL.
#  B) "Connect with Facebook" button (Embedded Signup): needs ALL FOUR values below. Guide: docs/embedded-signup.md
# Leave all four blank to keep only option A.

# Your platform's Meta app: App Dashboard > Settings > Basic
META_APP_ID=
META_APP_SECRET=
# Embedded Signup configuration id: App Dashboard > Facebook Login for Business > Configurations
META_ES_CONFIG_ID=
# A random string YOU choose (openssl rand -hex 24). Paste the same value as "Verify token" when you set the
# app's webhook Callback URL to  APP_URL/api/whatsapp/webhook
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Graph API version (blank = v25.0). Bump when Meta retires old versions.
WHATSAPP_GRAPH_VERSION=


# ==================== 4. RAZORPAY BILLING (optional) ====================
# Blank = billing off: the app works, paid plans just can't be bought. Guide: docs/billing-razorpay.md
# Use TEST keys first (they start with rzp_test_). Dashboard > Account & Settings > API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# You invent this and type it into Dashboard > Account & Settings > Webhooks (URL: APP_URL/api/razorpay/webhook)
RAZORPAY_WEBHOOK_SECRET=
# Created for you by `pnpm razorpay:setup`, which prints these three lines. Paste them here.
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_GROWTH=
RAZORPAY_PLAN_PRO=


# ==================== 5. E-MAIL ALERTS (optional) ====================
# Lets the app e-mail a business owner when a customer asks for a human. Blank = no e-mails (dashboard only).
# Any SMTP provider works (Amazon SES, Brevo, Zoho, Gmail app password...).
#   smtps://USERNAME:PASSWORD@smtp.example.com:465        (implicit TLS)
#   smtp://USERNAME:PASSWORD@smtp.example.com:587         (STARTTLS)
# URL-encode special characters in the password (@ becomes %40).
SMTP_URL=
# Must be an address your SMTP provider lets you send from, e.g.  Chatbase India <alerts@yourdomain.in>
EMAIL_FROM=
# One alert e-mail per conversation per this many minutes (blank = 15)
HANDOFF_EMAIL_COOLDOWN_MINUTES=
# A customer nobody answered for this many hours is handed back to the assistant (blank = 24, 0 = never)
HANDOFF_AUTO_RESUME_HOURS=


# ==================== 6. SAFETY & LIMITS ====================
# NEVER true on a public server: it lets people make the server fetch localhost/private addresses.
ALLOW_PRIVATE_URLS=false
# Sign-ups allowed per IP per hour (blank = 10). Raise only while running the test scripts repeatedly.
SIGNUP_RATE_LIMIT=
